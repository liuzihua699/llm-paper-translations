{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-paper-translations",
  "main": "scripts/worker.mjs",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  }
}
